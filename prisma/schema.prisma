// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ==================== Core Model: Security Logs ====================
model SecurityLog {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime  @default(now())
  source      String    @db.VarChar(255)
  severity    String    @db.VarChar(50)
  eventType   String    @map("event_type") @db.VarChar(100)
  description String?   @db.Text
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.Text
  rawLog      String?   @map("raw_log") @db.Text
  metadata    Json?     @db.JsonB
  embedding   String?   @db.Text // Vector embedding for similarity search
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  analysisResults        AnalysisResult[]
  pendingAdminDecisions  PendingAdminDecision[]
  autoAppliedRules       AutoAppliedRule[]

  @@index([timestamp])
  @@index([severity])
  @@index([eventType])
  @@index([ipAddress])
  @@map("security_logs")
}

// ==================== LLM Analysis Results ====================
model AnalysisResult {
  id              Int         @id @default(autoincrement())
  logId           Int         @map("log_id")
  result          Json        @db.JsonB // LLM response: threat_level, attack_type, indicators, recommendations
  confidence      Float?
  threatLevel     String?     @map("threat_level") @db.VarChar(50)
  analyzedAt      DateTime    @default(now()) @map("analyzed_at")

  // Relations
  securityLog SecurityLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([threatLevel])
  @@map("analysis_results")
}

// ==================== IP Blocking ====================
model BlockedIP {
  id          Int       @id @default(autoincrement())
  ipAddress   String    @map("ip_address") @db.Inet
  blockedAt   DateTime  @map("blocked_at") @default(now())
  expiresAt   DateTime  @map("expires_at")
  reason      String?   @db.Text
  active      Boolean   @default(true)

  @@unique([ipAddress])
  @@index([active])
  @@map("blocked_ips")
}

model PendingAdminDecision {
  id         Int       @id @default(autoincrement())
  logId      Int       @map("log_id")
  analysisId Int       @map("analysis_id")
  threatLevel String   @map("threat_level") @db.VarChar(50)
  analysis   Json      @db.JsonB
  status     String    @db.VarChar(50) // pending, resolved
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  // Relations
  log SecurityLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([status])
  @@map("pending_admin_decisions")
}

// ==================== Admin Decisions (Learning Source) ====================
model AdminDecision {
  id           Int      @id @default(autoincrement())
  logId        Int      @map("log_id")
  pendingId    Int      @map("pending_id")
  action       String   @db.VarChar(50)
  reason       String?  @db.Text
  duration     Int?     @default(3600)
  threatLevel  String   @map("threat_level") @db.VarChar(50)
  analysisData Json     @map("analysis_data") @db.JsonB
  applied      Boolean  @default(true)
  decidedAt    DateTime @default(now()) @map("decided_at")

  @@index([logId])
  @@index([action])
  @@index([decidedAt])
  @@map("admin_decisions")
}
// ==================== Auto-Applied Rules (PATH A) ====================
model AutoAppliedRule {
  id               Int      @id @default(autoincrement())
  logId            Int      @map("log_id")
  sourceDecisionId Int      @map("source_decision_id")
  sourceLogId      Int      @map("source_log_id")
  similarity       Float
  actionTaken      String   @map("action_taken") @db.VarChar(50)
  executedAt       DateTime @default(now()) @map("executed_at")

  log SecurityLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([actionTaken])
  @@index([executedAt])
  @@map("auto_applied_rules")
}