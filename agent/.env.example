# ==================== SentinelLog Agent Configuration ====================
# Copy this file to .env and fill in the values

# ─── Backend Connection ───────────────────────────────────────────
# URL ของ SentinelLog Backend (ไม่ต้องมี trailing slash)
BACKEND_URL=http://YOUR_BACKEND_IP:3000

# Secret สำหรับลงทะเบียน agent (ต้องตรงกับ AGENT_REGISTER_SECRET ใน backend .env)
AGENT_REGISTER_SECRET=your-super-secret-register-key

# ─── Agent Identity ───────────────────────────────────────────────
# ค่าเหล่านี้จะถูก auto-fill หลังจากรัน --register
AGENT_ID=
AGENT_API_KEY=

# ─── Nginx Log Paths ──────────────────────────────────────────────
NGINX_LOG_PATH=/var/log/nginx/access.log
NGINX_ERROR_LOG_PATH=/var/log/nginx/error.log

# ─── Intervals (วินาที) ───────────────────────────────────────────
LOG_BATCH_INTERVAL=30        # ส่ง log batch ทุกกี่วินาที
HEARTBEAT_INTERVAL=60        # ส่ง heartbeat ทุกกี่วินาที
COMMAND_POLL_INTERVAL=10     # poll คำสั่งจาก backend ทุกกี่วินาที
LOG_BATCH_SIZE=100           # จำนวน log สูงสุดต่อ batch

# ─── Firewall Backend ─────────────────────────────────────────────
# auto | iptables | ufw | nftables
FIREWALL_BACKEND=auto
