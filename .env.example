# ==================== SentinelLog Backend Configuration ====================
# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=""

# ─── JWT Auth ─────────────────────────────────────────────────────
JWT_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ─── Agent Registration ───────────────────────────────────────────
AGENT_REGISTER_SECRET=change-this-to-a-strong-random-secret
